include .config.inc.pug

mixin mkMenu(entries, current)
  each entry in entries
    - let addClass = (entry.title === title) ? "active" : null
    a(href=entry.href, title=entry.title)
      li(class=addClass)
        i.fa(class=entry.icon)
        |
        |
        | #{entry.title}
  

mixin glossary()
  #glossary
    p 
      | There are currently
      |
      span#nbProjects ?
      |
      | projects presented here with the following tags (click to filter):
      | 
      span#tags empty
    p#tagsMatchingInfo
      | Viewing the
      |
      span#nbOfProjectsMatching
      |
      |
      span#wordProject 
        span project
      |
      | with the 
      span#wordTag 
        span tag
      |
      | :
      span#selectedTags

mixin svgDecoration
  svg#redLine
    line(x1='0', y1='0', x2='0', y2='100%')
  svg#redCircle
    circle(cx='40', cy='40', r='40')
    text(x="50%", y="58%") Now

mixin project(date, title, link, pic, tags, id, details, imgLink)
  - var theId = id || title.replace(/\W+/g, "").toLowerCase()
  - var detailsHref = details === false ? null : (details || link)
  - var imgHref = imgLink === undefined ? link : imgLink
  - var hasImgWrap = imgLink === undefined ? (link != null) : !(imgLink === null || imgLink === false)
  article.project(id=theId)
    .info
      span.date
        i.fa.fa-calendar
        | &#160;#{date}
      if link != null
        a(href=link)
          h2= title
      else
        h2= title
      block
      if tags
        each tag in tags
          span.tag=tag
      if detailsHref != null
        a(href=detailsHref)
          h3
            i.fa.fa-link
            | &#160;More details

    .visual
      if hasImgWrap
        a(href=imgHref)
          if ! pic
            - pic = profilePicUrl
          img(src=pic, alt=title)
      else
        if ! pic
          - pic = profilePicUrl
        img(src=pic, alt=title)


html
  block vars
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='initial-scale=1.0')
    meta(name="description", content=metaDescription)
    - var siteUrl = "https://sylvain.doignon.fr" + (pageUrl || "/")
    meta(property="og:title", content=name + " | " + title)
    meta(property="og:description", content=metaDescription)
    meta(property="og:type", content="website")
    meta(property="og:url", content=siteUrl)
    meta(property="og:image", content=profilePicUrl)
    meta(name="twitter:card", content="summary")
    meta(name="twitter:title", content=name + " | " + title)
    meta(name="twitter:description", content=metaDescription)
    meta(name="twitter:image", content=profilePicUrl)
    script(type='application/ld+json').
      {
        "@type": "Person",
        "name": "#{name}",
        "url": "https://sylvain.doignon.fr/",
        "sameAs": ["#{linkedinProfile}", "#{githubProfile}"],
        "email": "mailto:#{emailAddress}"
      }
    block meta
    title= name + " | " + title
    link(rel="stylesheet", href="/css/all.min.css")
    link(rel="icon", href="/favicon.ico")
  body
    header
      #me
        a(href=profilePicFull, target="_blank", rel="noopener", title="View full size")
          img(src=profilePicUrlMini, alt="Portrait of Syl Doignon")
        h1= name
      #links
        a(href=linkedinProfile, title="LinkedIn")
          i.fa.fa-linkedin
          | &nbsp;
          | LinkedIn
        a(href=githubProfile, title="GitHub")
          i.fa.fa-github
          | &nbsp;
          | GitHub
      #about
        p= about
      ul#nav
        - 
          let entries = [ 
            {href: "/", title: "Personal projects", icon: "fa-home"},
            {href: "/cv.html", title: "CV", icon: "fa-file-text"}
          ]
        +mkMenu(entries, title)
    block content
    footer
      a(href=sourceWebsite)
        i.fa.fa-code-fork
        |
        | This website is homemade & available on GitHub
    .scripts
      block scripts
        script(src="/js/all.min.js")
