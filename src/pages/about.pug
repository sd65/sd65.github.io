extends .layout.inc.pug

block vars
  - var title = "Resume"
  - var pageUrl = "/about.html"
  - metaDescription = "My resume and contact information."

block content
  section#aboutme
    h2 Contact me
    a(href="mailto:" + emailAddress)
      i.fa.fa-envelope-o
      | 
      | #{emailAddress} 
    h2 My resume
    a(href=resumeLink)
      img(src=resumeThumbnail)
